{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mypaper.dev/schema/widget.schema.json",
  "title": "mypaper widget manifest",
  "description": "widget.json: the manifest of a mypaper widget. See docs/widgets.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "entry",
    "size"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Lowercase [a-z0-9-], unique. Also the folder name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+].+)?$"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "The HTML file to load, relative to the widget folder."
    },
    "size": {
      "type": "object",
      "description": "In grid cells, [columns, rows]. min <= default <= max.",
      "required": [
        "default",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/cells"
        },
        "min": {
          "$ref": "#/definitions/cells"
        },
        "max": {
          "$ref": "#/definitions/cells"
        }
      }
    },
    "resizable": {
      "type": "boolean",
      "default": true,
      "description": "false locks the size to size.default."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "description": "Anything not listed is denied.",
      "items": {
        "type": "string",
        "pattern": "^(system\\.stats|media|launch|theme|audio|user|storage\\.shared:[a-z0-9-]+|clipboard\\.write|network:https?://[^\\s/]+)$"
      }
    },
    "plugins": {
      "type": "array",
      "uniqueItems": true,
      "description": "Plugin ids whose methods this widget may call.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "settings": {
      "type": "array",
      "description": "Rendered by the shell in edit mode and by Studio.",
      "items": {
        "$ref": "#/definitions/setting"
      }
    },
    "replaces": {
      "type": "object",
      "description": "Widget ids this one took over, each with the settings an instance of the old widget gets. The host moves such instances onto this widget when widgets.json loads.",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "preset": {
      "type": "string",
      "enum": [
        "desktop",
        "overlay",
        "popup"
      ],
      "default": "desktop",
      "description": "desktop: on the grid, below windows. overlay: always on top, click-through except the widget. popup: opened from a bar module (bars host)."
    },
    "instances": {
      "type": "string",
      "enum": [
        "single",
        "multiple",
        "per-monitor"
      ],
      "default": "multiple",
      "description": "How many instances the user may add: one in total, any number, or one per monitor."
    }
  },
  "definitions": {
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "settingBase": {
      "type": "object",
      "required": [
        "key",
        "type",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "A section heading in the settings form, shown when it changes from one setting to the next."
        }
      }
    },
    "scalarSetting": {
      "allOf": [
        {
          "$ref": "#/definitions/settingBase"
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "boolean"
                },
                "default": {
                  "type": "boolean"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "string"
                },
                "default": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "color"
                },
                "default": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "alpha": {
                  "type": "boolean",
                  "description": "Allow #rrggbbaa (an opacity slider in the form)."
                }
              }
            },
            {
              "required": [
                "options"
              ],
              "properties": {
                "type": {
                  "const": "select"
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "icon": {
                            "type": "string",
                            "description": "A short glyph, an emoji or a symbol."
                          }
                        }
                      }
                    ]
                  }
                },
                "default": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "default": {
                  "type": "number"
                }
              }
            },
            {
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "type": {
                  "const": "slider"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "default": {
                  "type": "number"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "font"
                },
                "default": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "enum": [
                    "file",
                    "image"
                  ]
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9]+$"
                  }
                },
                "default": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "setting": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/scalarSetting"
            },
            {
              "required": [
                "default"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/settingBase"
            },
            {
              "required": [
                "fields",
                "default"
              ],
              "properties": {
                "type": {
                  "const": "list"
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "description": "The columns of each item. Scalar settings only, defaults optional.",
                  "items": {
                    "$ref": "#/definitions/scalarSetting"
                  }
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1
                },
                "default": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/settingBase"
            },
            {
              "required": [
                "default"
              ],
              "description": "A place: null is automatic (where this PC is), else { name, lat?, lon? }. The form suggests towns as you type from `search`, a method of one of this widget's plugins, called with { query }.",
              "properties": {
                "type": {
                  "const": "place"
                },
                "search": {
                  "type": "object",
                  "required": [
                    "plugin",
                    "method"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "plugin": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "default": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/definitions/place"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "place": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "dependentRequired": {
        "lat": [
          "lon"
        ],
        "lon": [
          "lat"
        ]
      }
    }
  }
}
