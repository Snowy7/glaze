{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mypaper.dev/schema/plugin.schema.json",
  "title": "mypaper plugin manifest",
  "description": "plugin.json: the manifest of a mypaper plugin (a separate process speaking JSON-RPC over stdio). See docs/widgets.md.",
  "type": "object",
  "required": ["id", "name", "version", "command", "methods"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+].+)?$" },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "The executable, relative to the plugin folder (or on PATH, like \"python\")."
    },
    "args": { "type": "array", "items": { "type": "string" }, "default": [] },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "description": "The methods widgets may call.",
      "items": { "type": "string", "minLength": 1, "not": { "enum": ["initialize", "shutdown", "suspend", "resume", "event"] } }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "description": "The events the plugin may emit.",
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "description": "Documentation for users and Studio. Plugins are native code and are not sandboxed.",
      "items": { "type": "string", "minLength": 1, "examples": ["network:https://api.open-meteo.com"] }
    }
  }
}
