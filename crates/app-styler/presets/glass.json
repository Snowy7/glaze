{
  "settings": {
    "rules": {
      "Grid#RootPageGrid": { "Background": "Transparent" },
      "ButtonEntityItem > Button#ContainerButton": { "BorderThickness": "0", "CornerRadius": "10" },
      "SettingsExpander ExpanderToggleButton#ContainerButton": { "BorderThickness": "0", "CornerRadius": "10" },
      "TextBox#CommandSearchTextBox": { "BorderThickness": "0", "CornerRadius": "16" },
      "Rectangle#SelectionIndicator": { "Fill": "$accent" }
    },
    "resources": {
      "ControlFillColorDefaultBrush": "light-dark(#66FFFFFF, #0AFFFFFF)",
      "ControlFillColorSecondaryBrush": "light-dark(#99FFFFFF, #12FFFFFF)",
      "ControlFillColorTertiaryBrush": "light-dark(#40FFFFFF, #06FFFFFF)",
      "CardBackgroundFillColorDefaultBrush": "light-dark(#66FFFFFF, #0AFFFFFF)"
    }
  },
  "explorer": {
    "rules": {
      "Grid#NavigationBarControlGrid": { "Background": "Transparent" },
      "TabViewItem Path#SelectedBackgroundPath": { "Fill": "{ThemeResource ControlFillColorSecondaryBrush}" },
      "CommandBarControl_Wave1 > Grid": { "Background": "Transparent", "BorderThickness": "0" },
      "CommandBar#FileExplorerCommandBar": { "Background": "Transparent" },
      "CommandBar#FileExplorerSecondaryCommandBar": { "Background": "Transparent" },
      "Grid#DetailsViewControlRootGrid": { "Background": "Transparent" },
      "AddressBarControl > Grid#PART_LayoutRoot": { "CornerRadius": "16" },
      "AutoSuggestBox#FileExplorerSearchBox TextBox#TextBox": { "BorderThickness": "0", "CornerRadius": "16" }
    },
    "resources": {
      "ControlFillColorDefaultBrush": "light-dark(#66FFFFFF, #0AFFFFFF)",
      "ControlFillColorSecondaryBrush": "light-dark(#99FFFFFF, #12FFFFFF)",
      "ControlFillColorTertiaryBrush": "light-dark(#40FFFFFF, #06FFFFFF)"
    }
  }
}
