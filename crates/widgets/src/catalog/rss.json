{
  "id": "rss",
  "name": "RSS",
  "category": "Info",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "Headlines from your favourite feeds; click one to open the article.",
  "size": {
    "default": [6, 4],
    "min": [4, 2],
    "max": [8, 8]
  },
  "resizable": true,
  "permissions": [
    "launch"
  ],
  "plugins": [
    "rss"
  ],
  "settings": [
    {
      "key": "feeds",
      "type": "list",
      "label": "Feeds",
      "fields": [
        {
          "key": "url",
          "type": "string",
          "label": "Feed URL"
        }
      ],
      "maxItems": 8,
      "default": [
        {
          "url": "https://hnrss.org/frontpage"
        },
        {
          "url": "https://feeds.bbci.co.uk/news/rss.xml"
        }
      ]
    },
    {
      "key": "variant",
      "type": "select",
      "label": "Display",
      "group": "Layout",
      "options": [
        {
          "value": "list",
          "label": "List",
          "icon": "☰"
        },
        {
          "value": "cards",
          "label": "Cards",
          "icon": "▤"
        }
      ],
      "default": "list"
    },
    {
      "key": "maxItems",
      "type": "number",
      "label": "Headlines",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "key": "showSource",
      "type": "boolean",
      "label": "Show source",
      "default": true
    },
    {
      "key": "showTime",
      "type": "boolean",
      "label": "Show time",
      "default": true
    },
    {
      "key": "refreshMinutes",
      "type": "number",
      "label": "Refresh (minutes)",
      "min": 15,
      "max": 120,
      "step": 5,
      "default": 20
    }
  ]
}
