{
  "id": "photo",
  "name": "Photos",
  "category": "Media",
  "version": "3.0.0",
  "author": "mypaper",
  "description": "Your pictures, full bleed, matted or as a polaroid, with a slow Ken Burns drift and soft crossfades.",
  "size": {
    "default": [6, 4],
    "min": [2, 2],
    "max": [12, 8]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Frame",
      "options": [
        {
          "value": "bleed",
          "label": "Full bleed",
          "icon": "▇"
        },
        {
          "value": "matte",
          "label": "Matte",
          "icon": "▣"
        },
        {
          "value": "polaroid",
          "label": "Polaroid",
          "icon": "▢"
        }
      ],
      "default": "bleed"
    },
    {
      "key": "image1",
      "type": "image",
      "label": "Photo 1",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "image2",
      "type": "image",
      "label": "Photo 2",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "image3",
      "type": "image",
      "label": "Photo 3",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "image4",
      "type": "image",
      "label": "Photo 4",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "image5",
      "type": "image",
      "label": "Photo 5",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "image6",
      "type": "image",
      "label": "Photo 6",
      "group": "Photos",
      "default": ""
    },
    {
      "key": "interval",
      "type": "slider",
      "label": "Change every",
      "group": "Playback",
      "min": 5,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 15
    },
    {
      "key": "motion",
      "type": "slider",
      "label": "Motion",
      "group": "Playback",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "key": "shuffle",
      "type": "boolean",
      "label": "Shuffle",
      "group": "Playback",
      "default": false
    },
    {
      "key": "fit",
      "type": "select",
      "label": "Fit",
      "group": "Look",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Whole picture"
        }
      ],
      "default": "cover"
    },
    {
      "key": "caption",
      "faces": ["polaroid"],
      "type": "string",
      "label": "Polaroid caption",
      "group": "Look",
      "default": ""
    }
  ],
  "replaces": {
    "photo-frame": {}
  }
}
