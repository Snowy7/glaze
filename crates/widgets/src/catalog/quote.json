{
  "id": "quote",
  "name": "Quote",
  "category": "Info",
  "version": "1.1.0",
  "author": "Glaze",
  "description": "A short quote, new every day. Click for another.",
  "size": {
    "default": [6, 2],
    "min": [4, 2],
    "max": [8, 4]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "mode",
      "type": "select",
      "label": "New quote",
      "options": [
        "daily",
        "hourly",
        "click"
      ],
      "default": "daily"
    },
    {
      "key": "source",
      "type": "select",
      "label": "Quotes from",
      "options": [
        "builtin",
        "custom",
        "both"
      ],
      "default": "builtin"
    },
    {
      "key": "custom",
      "type": "list",
      "label": "Your quotes",
      "fields": [
        {
          "key": "text",
          "type": "string",
          "label": "Quote"
        },
        {
          "key": "author",
          "type": "string",
          "label": "Author"
        }
      ],
      "maxItems": 50,
      "default": []
    }
  ]
}
