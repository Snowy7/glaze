{
  "id": "calendar",
  "name": "Calendar",
  "category": "Time",
  "version": "2.0.0",
  "author": "Glaze",
  "description": "Local events and read-only calendars from this PC, Google or Microsoft, merged in month, agenda and week views.",
  "size": {
    "default": [6, 6],
    "min": [4, 2],
    "max": [10, 8]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        {
          "value": "month",
          "label": "Month",
          "icon": "▦"
        },
        {
          "value": "agenda",
          "label": "Agenda",
          "icon": "☰"
        },
        {
          "value": "strip",
          "label": "Week",
          "icon": "▬"
        }
      ],
      "default": "month"
    },
    {
      "key": "weekStart",
      "type": "select",
      "label": "Week starts on",
      "group": "Calendar",
      "options": [
        "auto",
        "monday",
        "sunday",
        "saturday"
      ],
      "default": "auto"
    },
    {
      "key": "weekNumbers",
      "faces": ["month"],
      "type": "boolean",
      "label": "Week numbers",
      "group": "Calendar",
      "default": false
    }
  ]
}
