{
  "id": "quick-toggles",
  "name": "Quick toggles",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "Phone-style quick settings tiles that open the matching Windows Settings page, with live Wi-Fi and battery status.",
  "size": {
    "default": [
      4,
      2
    ],
    "min": [
      2,
      1
    ],
    "max": [
      4,
      4
    ]
  },
  "resizable": true,
  "permissions": [
    "launch",
    "system.stats"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid",
          "icon": "▦"
        },
        {
          "value": "row",
          "label": "Bar",
          "icon": "▬"
        },
        {
          "value": "list",
          "label": "List",
          "icon": "☰"
        }
      ],
      "default": "grid"
    },
    {
      "key": "wifi",
      "type": "boolean",
      "label": "Wi-Fi",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "bluetooth",
      "type": "boolean",
      "label": "Bluetooth",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "focus",
      "type": "boolean",
      "label": "Focus (do not disturb)",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "airplane",
      "type": "boolean",
      "label": "Airplane mode",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "nightlight",
      "type": "boolean",
      "label": "Night light",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "sound",
      "type": "boolean",
      "label": "Sound",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "display",
      "type": "boolean",
      "label": "Display",
      "group": "Tiles",
      "default": true
    },
    {
      "key": "battery",
      "type": "boolean",
      "label": "Battery",
      "group": "Tiles",
      "default": true
    }
  ]
}
