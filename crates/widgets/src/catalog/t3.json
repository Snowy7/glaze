{
  "id": "t3",
  "name": "T3 Code",
  "category": "Integrations",
  "version": "2.0.0",
  "author": "mypaper",
  "description": "Live running threads and agents, approvals, usage and a new thread prompt.",
  "size": {
    "default": [
      8,
      5
    ],
    "min": [
      4,
      3
    ],
    "max": [
      12,
      10
    ]
  },
  "resizable": true,
  "permissions": [
    "launch"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Face",
      "options": [
        {
          "value": "running",
          "label": "Running now"
        },
        {
          "value": "usage",
          "label": "Usage"
        },
        {
          "value": "new",
          "label": "New thread"
        },
        {
          "value": "attention",
          "label": "Needs you"
        }
      ],
      "default": "running"
    }
  ],
  "instances": "multiple"
}
