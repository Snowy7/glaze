{
  "id": "media-pill",
  "name": "Now playing pill",
  "category": "Media",
  "version": "1.0.0",
  "author": "Glaze",
  "description": "A slim always-on-top capsule with the current track, artwork, transport buttons and a progress hairline.",
  "size": {
    "default": [6, 2],
    "min": [4, 2],
    "max": [8, 2]
  },
  "resizable": true,
  "preset": "overlay",
  "instances": "single",
  "permissions": [
    "media"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Shape",
      "group": "Layout",
      "options": [
        {
          "value": "pill",
          "label": "Pill",
          "icon": "◖▬◗"
        },
        {
          "value": "notch",
          "label": "Notch",
          "icon": "▰"
        },
        {
          "value": "mini",
          "label": "Mini",
          "icon": "◖◗"
        }
      ],
      "default": "pill"
    },
    {
      "key": "progress",
      "type": "boolean",
      "label": "Progress line",
      "group": "Look",
      "default": true
    }
  ]
}
