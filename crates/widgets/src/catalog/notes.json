{
  "id": "notes",
  "name": "Notes",
  "category": "Productivity",
  "version": "1.1.0",
  "author": "Glaze",
  "description": "A sticky note with light markdown, saved as you type.",
  "size": {
    "default": [4, 4],
    "min": [2, 2],
    "max": [8, 8]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "fontScale",
      "type": "slider",
      "label": "Text size",
      "min": 0.8,
      "max": 1.6,
      "step": 0.1,
      "unit": "×",
      "default": 1
    }
  ]
}
