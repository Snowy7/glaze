{
  "id": "notes",
  "name": "Notes",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "A sticky note with light markdown, saved as you type.",
  "size": {
    "default": [
      2,
      2
    ],
    "min": [
      1,
      1
    ],
    "max": [
      4,
      4
    ],
    "allowed": [[1, 1], [2, 1], [3, 1], [4, 1], [1, 2], [2, 2], [3, 2], [4, 2], [1, 3], [2, 3], [3, 3], [4, 3], [1, 4], [2, 4], [3, 4], [4, 4]]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "fontScale",
      "type": "slider",
      "label": "Text size",
      "min": 0.8,
      "max": 1.6,
      "step": 0.1,
      "unit": "×",
      "default": 1
    }
  ]
}
