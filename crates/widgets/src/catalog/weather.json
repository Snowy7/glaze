{
  "id": "weather",
  "name": "Weather",
  "version": "3.0.0",
  "author": "mypaper",
  "description": "The weather where you are, or in any town: an animated sky, the next hours and the week. Weather by Open-Meteo.",
  "size": {
    "default": [
      3,
      2
    ],
    "min": [
      2,
      1
    ],
    "max": [5, 6],
    "allowed": [[2, 1], [3, 1], [4, 1], [5, 1], [2, 2], [3, 2], [4, 2], [5, 2], [2, 3], [3, 3], [4, 3], [5, 3], [2, 4], [3, 4], [4, 4], [5, 4], [2, 5], [3, 5], [4, 5], [5, 5], [2, 6], [3, 6], [4, 6], [5, 6]]
  },
  "resizable": true,
  "permissions": [
    "launch"
  ],
  "plugins": [
    "weather"
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        {
          "value": "card",
          "label": "Card",
          "icon": "◐"
        },
        {
          "value": "compact",
          "label": "Compact",
          "icon": "▭"
        },
        {
          "value": "forecast",
          "label": "Forecast",
          "icon": "▤"
        }
      ],
      "default": "card"
    },
    {
      "key": "city",
      "type": "place",
      "label": "Location",
      "group": "Location",
      "search": {
        "plugin": "weather",
        "method": "search"
      },
      "default": null
    },
    {
      "key": "units",
      "type": "select",
      "label": "Units",
      "group": "Units",
      "options": [
        {
          "value": "metric",
          "label": "Celsius",
          "icon": "°C"
        },
        {
          "value": "imperial",
          "label": "Fahrenheit",
          "icon": "°F"
        }
      ],
      "default": "metric"
    },
    {
      "key": "animate",
      "type": "boolean",
      "label": "Animated illustration",
      "group": "Look",
      "default": true
    }
  ]
}
