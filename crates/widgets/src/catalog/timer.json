{
  "id": "timer",
  "name": "Timer",
  "category": "Time",
  "version": "1.1.0",
  "author": "Glaze",
  "description": "Pomodoro and countdown timer with a thin progress ring. Keeps counting while Glaze is closed.",
  "size": {
    "default": [4, 4],
    "min": [2, 2],
    "max": [8, 8]
  },
  "resizable": true,
  "permissions": [
    "storage.shared:activity"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "focusMinutes",
      "type": "number",
      "label": "Focus (minutes)",
      "min": 1,
      "max": 180,
      "step": 1,
      "default": 25
    },
    {
      "key": "shortMinutes",
      "type": "number",
      "label": "Short break (minutes)",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 5
    },
    {
      "key": "longMinutes",
      "type": "number",
      "label": "Long break (minutes)",
      "min": 1,
      "max": 120,
      "step": 1,
      "default": 15
    },
    {
      "key": "customMinutes",
      "type": "number",
      "label": "Custom countdown (minutes)",
      "min": 1,
      "max": 600,
      "step": 1,
      "default": 10
    },
    {
      "key": "sessionsBeforeLong",
      "type": "number",
      "label": "Focus sessions before a long break",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "key": "autoAdvance",
      "type": "boolean",
      "label": "Start the next session automatically",
      "default": false
    }
  ]
}
