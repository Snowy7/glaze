{
  "id": "discord",
  "name": "Discord",
  "category": "Integrations",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "Recent Windows notifications, optional bot history and sending, and current call status with authorized Discord RPC.",
  "size": {
    "default": [8, 4],
    "min": [4, 4],
    "max": [8, 8]
  },
  "resizable": true,
  "permissions": [
    "launch"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "appId",
      "type": "string",
      "label": "Windows notification app ID",
      "default": "com.squirrel.Discord.Discord"
    }
  ]
}
