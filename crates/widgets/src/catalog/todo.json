{
  "id": "todo",
  "name": "To do",
  "category": "Productivity",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "A calm checklist: add, edit, check off and clear tasks.",
  "size": {
    "default": [4, 4],
    "min": [4, 2],
    "max": [8, 8]
  },
  "resizable": true,
  "permissions": [
    "storage.shared:activity"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "title",
      "type": "string",
      "label": "Title (empty to hide)",
      "default": "To do"
    },
    {
      "key": "addPosition",
      "type": "select",
      "label": "Add field",
      "options": [
        "bottom",
        "top"
      ],
      "default": "bottom"
    },
    {
      "key": "hideDone",
      "type": "boolean",
      "label": "Hide completed tasks",
      "default": false
    }
  ]
}
