{
  "id": "system-monitor",
  "name": "System",
  "category": "System",
  "version": "3.0.0",
  "author": "mypaper",
  "description": "CPU, memory, GPU, network, drives and battery, as rings, bars or live graphs.",
  "size": {
    "default": [6, 4],
    "min": [2, 2],
    "max": [12, 8]
  },
  "resizable": true,
  "permissions": [
    "system.stats"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Look",
      "default": "rings",
      "options": [
        {
          "value": "rings",
          "label": "Rings",
          "icon": "◎"
        },
        {
          "value": "bars",
          "label": "Bars",
          "icon": "☰"
        },
        {
          "value": "spark",
          "label": "Graphs",
          "icon": "〰"
        }
      ]
    },
    {
      "key": "cpu",
      "type": "boolean",
      "label": "CPU",
      "group": "Show",
      "default": true
    },
    {
      "key": "ram",
      "type": "boolean",
      "label": "Memory",
      "group": "Show",
      "default": true
    },
    {
      "key": "gpu",
      "type": "boolean",
      "label": "GPU",
      "group": "Show",
      "default": true
    },
    {
      "key": "net",
      "type": "boolean",
      "label": "Network",
      "group": "Show",
      "default": true
    },
    {
      "key": "disk",
      "type": "boolean",
      "label": "Drives",
      "group": "Show",
      "default": false
    },
    {
      "key": "battery",
      "type": "boolean",
      "label": "Battery (when there is one)",
      "group": "Show",
      "default": true
    },
    {
      "key": "drives",
      "when": {"disk": [true]},
      "type": "string",
      "label": "Only these drives, e.g. C, D (empty: all)",
      "group": "Show",
      "default": ""
    },
    {
      "key": "interval",
      "type": "select",
      "label": "Update every",
      "group": "Look",
      "default": "2000",
      "options": [
        {
          "value": "1000",
          "label": "1 s"
        },
        {
          "value": "2000",
          "label": "2 s"
        },
        {
          "value": "5000",
          "label": "5 s"
        }
      ]
    },
    {
      "key": "vary",
      "type": "boolean",
      "label": "A color per metric",
      "group": "Look",
      "default": true
    }
  ],
  "replaces": {
    "system-info": {
      "variant": "bars",
      "cpu": true,
      "ram": true,
      "gpu": true,
      "net": true,
      "disk": true,
      "battery": true
    },
    "disk": {
      "variant": "bars",
      "cpu": false,
      "ram": false,
      "gpu": false,
      "net": false,
      "disk": true,
      "battery": false
    },
    "network": {
      "variant": "bars",
      "cpu": false,
      "ram": false,
      "gpu": false,
      "net": true,
      "disk": false,
      "battery": false
    },
    "battery": {
      "variant": "rings",
      "cpu": false,
      "ram": false,
      "gpu": false,
      "net": false,
      "disk": false,
      "battery": true
    }
  }
}
