{
  "id": "heatmap",
  "name": "Activity heatmap",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "A contribution-style heatmap of the tasks you finish and the focus sessions you complete.",
  "size": {
    "default": [
      4,
      2
    ],
    "min": [
      2,
      1
    ],
    "max": [
      8,
      3
    ],
    "allowed": [[2, 1], [3, 1], [4, 1], [5, 1], [6, 1], [7, 1], [8, 1], [2, 2], [3, 2], [4, 2], [5, 2], [6, 2], [7, 2], [8, 2], [2, 3], [3, 3], [4, 3], [5, 3], [6, 3], [7, 3], [8, 3]]
  },
  "resizable": true,
  "permissions": [
    "storage.shared:activity"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Style",
      "group": "Layout",
      "options": [
        {
          "value": "weeks",
          "label": "Weeks",
          "icon": "▦"
        },
        {
          "value": "month",
          "label": "Month",
          "icon": "▣"
        },
        {
          "value": "streak",
          "label": "Streak",
          "icon": "↯"
        }
      ],
      "default": "weeks"
    },
    {
      "key": "source",
      "type": "select",
      "label": "Count",
      "group": "Content",
      "options": [
        {
          "value": "all",
          "label": "Everything",
          "icon": "∑"
        },
        {
          "value": "todo",
          "label": "Tasks",
          "icon": "☑"
        },
        {
          "value": "timer",
          "label": "Focus sessions",
          "icon": "◷"
        }
      ],
      "default": "all"
    },
    {
      "key": "weekStart",
      "type": "select",
      "label": "Week starts on",
      "group": "Look",
      "options": [
        "monday",
        "sunday"
      ],
      "default": "monday"
    },
    {
      "key": "labels",
      "type": "boolean",
      "label": "Month and weekday labels",
      "group": "Look",
      "default": true
    },
    {
      "key": "legend",
      "type": "boolean",
      "label": "Legend",
      "group": "Look",
      "default": true
    }
  ]
}
