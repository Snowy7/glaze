{
  "id": "heatmap",
  "name": "Activity heatmap",
  "category": "Productivity",
  "version": "1.0.0",
  "author": "Glaze",
  "description": "A contribution-style heatmap of the tasks you finish and the focus sessions you complete.",
  "size": {
    "default": [8, 4],
    "min": [4, 2],
    "max": [16, 6]
  },
  "resizable": true,
  "permissions": [
    "storage.shared:activity"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Style",
      "group": "Layout",
      "options": [
        {
          "value": "weeks",
          "label": "Weeks",
          "icon": "▦"
        },
        {
          "value": "month",
          "label": "Month",
          "icon": "▣"
        },
        {
          "value": "streak",
          "label": "Streak",
          "icon": "↯"
        }
      ],
      "default": "weeks"
    },
    {
      "key": "source",
      "type": "select",
      "label": "Count",
      "group": "Content",
      "options": [
        {
          "value": "all",
          "label": "Everything",
          "icon": "∑"
        },
        {
          "value": "todo",
          "label": "Tasks",
          "icon": "☑"
        },
        {
          "value": "timer",
          "label": "Focus sessions",
          "icon": "◷"
        }
      ],
      "default": "all"
    },
    {
      "key": "weekStart",
      "type": "select",
      "label": "Week starts on",
      "group": "Look",
      "options": [
        "monday",
        "sunday"
      ],
      "default": "monday"
    },
    {
      "key": "labels",
      "type": "boolean",
      "label": "Month and weekday labels",
      "group": "Look",
      "default": true
    },
    {
      "key": "legend",
      "type": "boolean",
      "label": "Legend",
      "group": "Look",
      "default": true
    }
  ]
}
