{
  "id": "clock",
  "name": "Clock",
  "category": "Time",
  "version": "3.0.0",
  "author": "Glaze",
  "description": "The time five ways: big digital, split-flap, an analog dial, a greeting, or your cities around the world.",
  "size": {
    "default": [6, 4],
    "min": [2, 2],
    "max": [12, 8]
  },
  "resizable": true,
  "permissions": [
    "user"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Face",
      "options": [
        {
          "value": "desk",
          "label": "Digital",
          "icon": "12"
        },
        {
          "value": "flip",
          "label": "Flip",
          "icon": "▤"
        },
        {
          "value": "analog",
          "label": "Analog",
          "icon": "◷"
        },
        {
          "value": "words",
          "label": "Greeting",
          "icon": "Aa"
        },
        {
          "value": "world",
          "label": "World",
          "icon": "◍"
        }
      ],
      "default": "desk"
    },
    {
      "key": "format24",
      "faces": ["desk", "flip", "words", "world"],
      "type": "boolean",
      "label": "24-hour clock",
      "group": "Time",
      "default": true
    },
    {
      "key": "showSeconds",
      "faces": ["desk", "flip", "analog"],
      "type": "boolean",
      "label": "Seconds (Digital, Flip, Analog)",
      "group": "Time",
      "default": false
    },
    {
      "key": "showDate",
      "type": "boolean",
      "label": "Date",
      "group": "Time",
      "default": true
    },
    {
      "key": "zones",
      "faces": ["world"],
      "type": "list",
      "label": "Cities (World face)",
      "group": "World",
      "maxItems": 8,
      "fields": [
        {
          "key": "label",
          "type": "string",
          "label": "Name"
        },
        {
          "key": "tz",
          "type": "string",
          "label": "Time zone, e.g. Europe/London"
        }
      ],
      "default": [
        {
          "label": "New York",
          "tz": "America/New_York"
        },
        {
          "label": "London",
          "tz": "Europe/London"
        },
        {
          "label": "Tokyo",
          "tz": "Asia/Tokyo"
        },
        {
          "label": "Sydney",
          "tz": "Australia/Sydney"
        }
      ]
    },
    {
      "key": "name",
      "faces": ["words"],
      "type": "string",
      "label": "Name to greet (empty: your Windows name)",
      "group": "Greeting",
      "default": ""
    },
    {
      "key": "font",
      "type": "font",
      "label": "Font (empty: the widget font)",
      "group": "Look",
      "default": ""
    }
  ],
  "replaces": {
    "analog-clock": {
      "variant": "analog"
    },
    "world-clock": {
      "variant": "world"
    },
    "greeting": {
      "variant": "words"
    }
  }
}
