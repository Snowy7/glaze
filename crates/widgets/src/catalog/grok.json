{
  "id": "grok",
  "name": "Grok Bot",
  "category": "Integrations",
  "version": "2.0.0",
  "author": "mypaper",
  "description": "Discover Grok Bot, run saved routines, open prompts and view recent requests.",
  "size": {
    "default": [
      8,
      5
    ],
    "min": [
      4,
      3
    ],
    "max": [
      12,
      10
    ]
  },
  "resizable": true,
  "permissions": [
    "launch"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Face",
      "options": [
        {
          "value": "routines",
          "label": "Routines"
        },
        {
          "value": "recent",
          "label": "Recent requests and notifications"
        },
        {
          "value": "prompt",
          "label": "Quick prompt"
        }
      ],
      "default": "routines"
    }
  ],
  "instances": "multiple"
}
