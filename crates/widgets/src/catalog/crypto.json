{
  "id": "crypto",
  "name": "Crypto",
  "category": "Info",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "Prices and 24h change for the coins you follow (CoinGecko, no API key).",
  "size": {
    "default": [4, 4],
    "min": [2, 2],
    "max": [8, 6]
  },
  "resizable": true,
  "permissions": [
    "network:https://api.coingecko.com"
  ],
  "plugins": [],
  "settings": [
    {
      "key": "coins",
      "type": "list",
      "label": "Coins (CoinGecko ids)",
      "fields": [
        {
          "key": "id",
          "type": "string",
          "label": "Coin id, e.g. bitcoin"
        }
      ],
      "maxItems": 6,
      "default": [
        {
          "id": "bitcoin"
        },
        {
          "id": "ethereum"
        },
        {
          "id": "solana"
        }
      ]
    },
    {
      "key": "currency",
      "type": "select",
      "label": "Currency",
      "options": [
        {
          "value": "usd",
          "label": "US dollar",
          "icon": "$"
        },
        {
          "value": "eur",
          "label": "Euro",
          "icon": "€"
        },
        {
          "value": "gbp",
          "label": "Pound",
          "icon": "£"
        },
        {
          "value": "jpy",
          "label": "Yen",
          "icon": "¥"
        }
      ],
      "default": "usd"
    },
    {
      "key": "showChange",
      "type": "boolean",
      "label": "Show 24h change",
      "default": true
    },
    {
      "key": "refreshMinutes",
      "type": "number",
      "label": "Refresh (minutes)",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 5
    }
  ]
}
