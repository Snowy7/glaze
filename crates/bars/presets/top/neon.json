{
  "layout": "floating",
  "height": 36,
  "margin": 10,
  "padding": 8,
  "width": "auto",
  "left": [
    "start",
    "workspaces",
    "app"
  ],
  "center": [
    "clock"
  ],
  "right": [
    "media",
    "tray",
    "network",
    "volume",
    "battery",
    "stats",
    "power"
  ],
  "look": {
    "scheme": "dark",
    "family": "mono",
    "background": {
      "type": "wallpaper",
      "brightness": 0.5
    },
    "tint": 0.55,
    "saturation": 1.7,
    "noise": 0.06,
    "radius": 16,
    "border": {
      "rest": {
        "width": 1,
        "color": {
          "angle": 115,
          "stops": [
            "#ff2bd6",
            "#7b5cff",
            "#00e5ff"
          ]
        }
      },
      "hover": {
        "width": 1.5
      }
    },
    "glow": {
      "rest": {
        "color": "#a04cff",
        "size": 10,
        "opacity": 0.38
      },
      "hover": {
        "size": 14,
        "opacity": 0.6
      }
    },
    "items": {
      "radius": 9,
      "hover": {
        "background": "#ffffff10",
        "color": "#ffffff",
        "glow": {
          "color": "#ff2bd6",
          "size": 14,
          "opacity": 0.55
        }
      },
      "active": {
        "background": {
          "angle": 90,
          "stops": [
            "#ff2bd640",
            "#00e5ff40"
          ]
        },
        "color": "#ffffff"
      }
    }
  },
  "animation": {
    "duration": 220,
    "curve": "overshoot",
    "bar": {
      "style": "scale"
    },
    "open": {
      "style": "pop"
    }
  },
  "spacing": 4
}
