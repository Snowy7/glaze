{
  "style": "floating",
  "size": 48,
  "padding": 7,
  "margin": 6,
  "spacing": 6,
  "indicator": "dot",
  "counter": false,
  "attention": "bounce",
  "magnify": {
    "scale": 1.65,
    "range": 3
  },
  "extras": [
    "trash"
  ],
  "look": {
    "scheme": "auto",
    "family": "macos",
    "glyphs": "symbols",
    "font": {
      "family": "\"SF Pro Text\", \"SF Pro\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
      "size": 13
    },
    "background": {
      "type": "wallpaper",
      "brightness": 1.06
    },
    "tint": 0.18,
    "saturation": 1.85,
    "noise": 0.012,
    "radius": 20,
    "corners": "round",
    "border": {
      "rest": {
        "width": 1,
        "color": "#ffffff2e"
      }
    },
    "shadow": {
      "rest": {
        "y": 1,
        "blur": 6,
        "color": "#0000002e"
      }
    },
    "glass": {
      "style": "liquid",
      "intensity": 1,
      "refraction": 0.55,
      "highlight": 0.5,
      "tint": 0.08,
      "blur": 0.5
    },
    "items": {
      "radius": 10
    },
    "indicator": {
      "running": "text",
      "active": "text",
      "attention": "#ff9f0a"
    }
  },
  "animation": {
    "duration": 240,
    "curve": "spring",
    "bar": {
      "style": "slide",
      "dock": {
        "magnify": {
          "curve": "linear",
          "duration": 70
        },
        "bounce": {
          "duration": 620
        }
      }
    },
    "open": {
      "style": "fade",
      "curve": "ease-out",
      "duration": 130
    }
  }
}
