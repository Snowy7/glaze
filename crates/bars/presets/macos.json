{
  "top": {
    "layout": "strip",
    "height": 28,
    "left": ["start", "app", "workspaces"],
    "center": [],
    "right": ["media", "tray", "network", "volume", "battery", "quick", "clock"]
  },
  "dock": {
    "style": "floating",
    "size": 52,
    "padding": 6,
    "margin": 6,
    "spacing": 5,
    "indicator": "dot",
    "magnify": { "scale": 1.8, "range": 3.2 },
    "extras": ["trash"]
  },
  "look": {
    "scheme": "auto",
    "background": { "type": "wallpaper" },
    "tint": 0.38,
    "saturation": 1.9,
    "noise": 0.02,
    "radius": 22,
    "corners": "squircle",
    "border": { "rest": { "width": 1, "color": "#ffffff2e" } },
    "shadow": { "rest": { "y": 4, "blur": 12, "color": "#00000040" } },
    "items": {
      "radius": 6,
      "hover": { "background": "#ffffff26" },
      "active": { "background": "#ffffff33" }
    },
    "indicator": { "running": "text", "active": "text", "attention": "#ff9f0a" }
  },
  "animation": {
    "duration": 240,
    "curve": "spring",
    "bar": { "style": "slide", "dock": { "magnify": { "curve": "linear", "duration": 70 } } },
    "open": { "style": "scale", "curve": "snappy", "duration": 170 }
  }
}
