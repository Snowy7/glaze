{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "world-clock",
  "name": "World Clock",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "The time in several cities at a glance, with day or night, day offset and hour difference.",
  "entry": "index.html",
  "size": { "default": [2, 2], "min": [2, 1], "max": [4, 3] },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "zones",
      "type": "list",
      "label": "Cities",
      "maxItems": 8,
      "fields": [
        { "key": "label", "type": "string", "label": "Name" },
        { "key": "tz", "type": "string", "label": "Time zone (e.g. Europe/London)" }
      ],
      "default": [
        { "label": "New York", "tz": "America/New_York" },
        { "label": "London", "tz": "Europe/London" },
        { "label": "Tokyo", "tz": "Asia/Tokyo" },
        { "label": "Sydney", "tz": "Australia/Sydney" }
      ]
    },
    { "key": "format24", "type": "boolean", "label": "24-hour clock", "default": true },
    { "key": "showOffset", "type": "boolean", "label": "Show day and hour difference", "default": true }
  ]
}
