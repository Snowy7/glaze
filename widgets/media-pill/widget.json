{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "media-pill",
  "name": "Now playing pill",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "A slim always-on-top capsule with the current track, artwork, transport buttons and a progress hairline.",
  "entry": "index.html",
  "size": { "default": [3, 1], "min": [2, 1], "max": [4, 1] },
  "resizable": true,
  "preset": "overlay",
  "instances": "single",
  "permissions": ["media"],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Shape",
      "group": "Layout",
      "options": [
        { "value": "pill", "label": "Pill", "icon": "◖▬◗" },
        { "value": "notch", "label": "Notch", "icon": "▰" },
        { "value": "mini", "label": "Mini", "icon": "◖◗" }
      ],
      "default": "pill"
    },
    { "key": "progress", "type": "boolean", "label": "Progress line", "group": "Look", "default": true }
  ]
}
