{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "app-shortcuts",
  "name": "App shortcuts",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "Your apps with their real icons: a magnifying dock, an icon grid or a list.",
  "entry": "index.html",
  "size": { "default": [4, 2], "min": [2, 1], "max": [8, 4] },
  "resizable": true,
  "permissions": ["launch"],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        { "value": "dock", "label": "Dock", "icon": "▃" },
        { "value": "grid", "label": "Grid", "icon": "▦" },
        { "value": "list", "label": "List", "icon": "☰" }
      ],
      "default": "dock"
    },
    { "key": "iconSize", "type": "slider", "label": "Icon size", "group": "Look", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "key": "labels", "type": "boolean", "label": "Show names", "group": "Look", "default": true },
    {
      "key": "shortcuts",
      "type": "list",
      "label": "Apps (an .exe path, or shell:AppsFolder\\<app id>)",
      "group": "Apps",
      "fields": [
        { "key": "label", "type": "string", "label": "Name" },
        { "key": "target", "type": "string", "label": "Path, app id or link" }
      ],
      "maxItems": 24,
      "default": [
        { "label": "Files", "target": "C:\\Windows\\explorer.exe" },
        { "label": "Notepad", "target": "C:\\Windows\\System32\\notepad.exe" },
        { "label": "Calculator", "target": "C:\\Windows\\System32\\calc.exe" },
        { "label": "Paint", "target": "C:\\Windows\\System32\\mspaint.exe" },
        { "label": "Command Prompt", "target": "C:\\Windows\\System32\\cmd.exe" },
        { "label": "Settings", "target": "shell:AppsFolder\\windows.immersivecontrolpanel_cw5n1h2txyewy!microsoft.windows.immersivecontrolpanel" }
      ]
    }
  ]
}
