{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "now-playing",
  "name": "Now playing",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "What's playing, with artwork, progress and transport controls.",
  "entry": "index.html",
  "size": { "default": [3, 1], "min": [2, 1], "max": [4, 2] },
  "resizable": true,
  "permissions": ["media", "theme"],
  "plugins": [],
  "settings": [
    { "key": "wallpaperAccent", "type": "boolean", "label": "Use wallpaper accent", "default": false },
    { "key": "blurArtwork", "type": "boolean", "label": "Artwork backdrop", "default": true }
  ]
}
