{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "battery",
  "name": "Battery",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "Battery level and charging state as a calm ring, bar or number.",
  "entry": "index.html",
  "size": { "default": [1, 1], "min": [1, 1], "max": [3, 2] },
  "resizable": true,
  "permissions": ["system.stats"],
  "plugins": [],
  "settings": [
    { "key": "style", "type": "select", "label": "Style", "options": ["ring", "bar", "number"], "default": "ring" },
    { "key": "hideWhenMissing", "type": "boolean", "label": "Hide when there is no battery", "default": false }
  ]
}
