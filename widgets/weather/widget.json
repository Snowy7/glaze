{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "weather",
  "name": "Weather",
  "version": "2.0.0",
  "author": "mypaper",
  "description": "Current conditions with an animated illustration, the next hours and the days ahead (open-meteo, no API key).",
  "entry": "index.html",
  "size": { "default": [3, 2], "min": [2, 1], "max": [5, 3] },
  "resizable": true,
  "permissions": [],
  "plugins": ["weather"],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        { "value": "card", "label": "Card", "icon": "◐" },
        { "value": "compact", "label": "Compact", "icon": "▭" },
        { "value": "forecast", "label": "Forecast", "icon": "▤" }
      ],
      "default": "card"
    },
    { "key": "city", "type": "string", "label": "City", "group": "Location", "default": "London" },
    { "key": "lat", "type": "string", "label": "Latitude (overrides city)", "group": "Location", "default": "" },
    { "key": "lon", "type": "string", "label": "Longitude (overrides city)", "group": "Location", "default": "" },
    {
      "key": "units",
      "type": "select",
      "label": "Units",
      "group": "Units",
      "options": [
        { "value": "metric", "label": "Celsius", "icon": "°C" },
        { "value": "imperial", "label": "Fahrenheit", "icon": "°F" }
      ],
      "default": "metric"
    },
    { "key": "animate", "type": "boolean", "label": "Animated illustration", "group": "Look", "default": true }
  ]
}
