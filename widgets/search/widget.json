{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "search",
  "name": "Search",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "A search box that opens your default browser, with the engine of your choice.",
  "entry": "index.html",
  "size": { "default": [3, 1], "min": [2, 1], "max": [4, 1] },
  "resizable": true,
  "permissions": ["launch"],
  "plugins": [],
  "settings": [
    {
      "key": "engine",
      "type": "select",
      "label": "Search engine",
      "options": ["duckduckgo", "google", "bing", "brave", "ecosia", "startpage", "custom"],
      "default": "duckduckgo"
    },
    {
      "key": "customUrl",
      "type": "string",
      "label": "Custom engine URL ({q} is the search text)",
      "default": "https://duckduckgo.com/?q={q}"
    },
    { "key": "openUrls", "type": "boolean", "label": "Open addresses directly", "default": true }
  ]
}
