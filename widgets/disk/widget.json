{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "disk",
  "name": "Disks",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "How full each drive is, as bars or rings.",
  "entry": "index.html",
  "size": { "default": [2, 2], "min": [2, 1], "max": [4, 3] },
  "resizable": true,
  "permissions": ["system.stats"],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Display",
      "group": "Layout",
      "options": [
        { "value": "bars", "label": "Bars", "icon": "▬" },
        { "value": "rings", "label": "Rings", "icon": "◯" }
      ],
      "default": "bars"
    },
    { "key": "drives", "type": "string", "label": "Drives to show (letters, e.g. C, D; empty for all)", "default": "" },
    { "key": "showFree", "type": "boolean", "label": "Show free space instead of used", "default": false }
  ]
}
