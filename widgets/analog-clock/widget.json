{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "analog-clock",
  "name": "Analog Clock",
  "version": "1.1.0",
  "author": "mypaper",
  "description": "A thin, calm analog clock with an optional seconds hand, numerals and date.",
  "entry": "index.html",
  "size": { "default": [2, 2], "min": [1, 1], "max": [4, 4] },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    { "key": "showSeconds", "type": "boolean", "label": "Seconds hand", "default": true },
    { "key": "smooth", "type": "boolean", "label": "Smooth seconds sweep (uses more power)", "default": false },
    { "key": "numerals", "type": "select", "label": "Numerals", "options": ["none", "quarters", "all"], "default": "quarters" },
    { "key": "showDate", "type": "boolean", "label": "Show date", "default": true }
  ]
}
