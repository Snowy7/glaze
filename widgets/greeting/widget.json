{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "greeting",
  "name": "Greeting",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "A big, warm hello that knows the time of day and your name.",
  "entry": "index.html",
  "size": { "default": [4, 2], "min": [2, 1], "max": [8, 3] },
  "resizable": true,
  "permissions": ["user"],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        { "value": "hero", "label": "Hero", "icon": "Aa" },
        { "value": "inline", "label": "Line", "icon": "▬" },
        { "value": "stack", "label": "Stack", "icon": "☰" }
      ],
      "default": "hero"
    },
    {
      "key": "wording",
      "type": "select",
      "label": "Wording",
      "group": "Content",
      "options": [
        { "value": "friendly", "label": "Friendly" },
        { "value": "formal", "label": "Formal" },
        { "value": "short", "label": "Short" }
      ],
      "default": "friendly"
    },
    { "key": "name", "type": "string", "label": "Name (empty: your Windows name)", "group": "Content", "default": "" },
    {
      "key": "line",
      "type": "select",
      "label": "Line underneath",
      "group": "Content",
      "options": [
        { "value": "date", "label": "Date" },
        { "value": "progress", "label": "Day progress" },
        { "value": "custom", "label": "Custom text" },
        { "value": "none", "label": "None" }
      ],
      "default": "date"
    },
    { "key": "custom", "type": "string", "label": "Custom text", "group": "Content", "default": "" }
  ]
}
