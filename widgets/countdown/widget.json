{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "countdown",
  "name": "Countdown",
  "version": "2.0.0",
  "author": "mypaper",
  "description": "Days to (or since) a date that matters, as a big number or a ring of the time gone by.",
  "entry": "index.html",
  "size": {
    "default": [2, 1],
    "min": [1, 1],
    "max": [4, 2]
  },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "style",
      "type": "select",
      "label": "Look",
      "default": "digits",
      "options": [
        {
          "value": "digits",
          "label": "Number",
          "icon": "57"
        },
        {
          "value": "ring",
          "label": "Ring",
          "icon": "◔"
        }
      ]
    },
    {
      "key": "title",
      "type": "string",
      "label": "Event",
      "group": "Event",
      "default": "New Year"
    },
    {
      "key": "date",
      "type": "string",
      "label": "Date, YYYY-MM-DD (empty: the next 1 January)",
      "group": "Event",
      "default": ""
    },
    {
      "key": "time",
      "type": "string",
      "label": "Time, HH:MM",
      "group": "Event",
      "default": "00:00"
    },
    {
      "key": "afterwards",
      "type": "select",
      "label": "Once it has passed",
      "group": "Event",
      "default": "countUp",
      "options": [
        {
          "value": "countUp",
          "label": "Count the days since"
        },
        {
          "value": "stop",
          "label": "Say it's done"
        }
      ]
    },
    {
      "key": "showSeconds",
      "type": "boolean",
      "label": "Seconds",
      "group": "Look",
      "default": false
    },
    {
      "key": "startDate",
      "type": "string",
      "label": "Ring starts on, YYYY-MM-DD (empty: a year before)",
      "group": "Look",
      "default": ""
    }
  ]
}
