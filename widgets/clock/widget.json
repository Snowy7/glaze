{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "clock",
  "name": "Clock",
  "version": "2.0.0",
  "author": "mypaper",
  "description": "A big desktop clock with the date: desk, flip or minimal.",
  "entry": "index.html",
  "size": { "default": [3, 2], "min": [2, 1], "max": [6, 3] },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "group": "Layout",
      "options": [
        { "value": "desk", "label": "Desk", "icon": "◧" },
        { "value": "flip", "label": "Flip", "icon": "▤" },
        { "value": "minimal", "label": "Minimal", "icon": "◌" }
      ],
      "default": "desk"
    },
    { "key": "format24", "type": "boolean", "label": "24-hour clock", "group": "Time", "default": true },
    { "key": "showSeconds", "type": "boolean", "label": "Show seconds", "group": "Time", "default": false },
    { "key": "showDate", "type": "boolean", "label": "Show date", "group": "Date", "default": true },
    {
      "key": "dateFormat",
      "type": "select",
      "label": "Date format",
      "group": "Date",
      "options": [
        { "value": "full", "label": "4 November 2026" },
        { "value": "short", "label": "4 Nov" },
        { "value": "numeric", "label": "04/11/2026" }
      ],
      "default": "full"
    },
    { "key": "font", "type": "font", "label": "Font (empty: the widget font)", "group": "Look", "default": "" },
    { "key": "size", "type": "slider", "label": "Time size", "group": "Look", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ]
}
