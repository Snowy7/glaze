{
  "$schema": "../../packages/widget-sdk/schema/widget.schema.json",
  "id": "notes",
  "name": "Notes",
  "version": "1.0.0",
  "author": "mypaper",
  "description": "A sticky note with light markdown, saved as you type.",
  "entry": "index.html",
  "size": { "default": [2, 2], "min": [1, 1], "max": [4, 4] },
  "resizable": true,
  "permissions": [],
  "plugins": [],
  "settings": [
    { "key": "fontScale", "type": "number", "label": "Text size", "min": 0.8, "max": 1.6, "step": 0.1, "default": 1 }
  ]
}
