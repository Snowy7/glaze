{
  "$schema": "../../packages/widget-sdk/schema/plugin.schema.json",
  "id": "weather",
  "name": "Weather",
  "version": "1.2.0",
  "command": "weather.exe",
  "args": [],
  "methods": ["current", "forecast", "locate", "search"],
  "events": ["updated"],
  "component": "weather.wasm",
  "api": "0.1",
  "faces": [{ "id": "now", "name": "Now", "icon": "cloud-sun", "size": { "default": [8, 6], "min": [6, 4], "max": [16, 12] } }],
  "permissions": ["location", "network:https://api.open-meteo.com", "network:https://geocoding-api.open-meteo.com", "network:https://ipwho.is", "network:https://api.bigdatacloud.net"]
}
