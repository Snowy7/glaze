{
  "id": "discord",
  "name": "Discord",
  "version": "0.1.0",
  "component": "discord.wasm",
  "api": "0.1",
  "faces": [{ "id": "main", "name": "Messages and call", "icon": "message", "size": { "default": [8, 5], "min": [4, 4], "max": [12, 12] } }],
  "permissions": ["pipe:discord-ipc-0", "secrets", "network:https://discord.com"],
  "settings": [
    { "key": "clientId", "type": "string", "label": "Discord application ID", "default": "" },
    { "key": "channelIds", "type": "string", "label": "Bot channel IDs (comma separated, up to 8)", "default": "" },
    { "key": "rpc", "type": "boolean", "label": "Connect current call through Discord RPC", "default": false },
    { "key": "voiceControls", "type": "boolean", "label": "Request microphone and deafen controls", "default": false }
  ],
  "limits": { "memory_mb": 16 }
}
