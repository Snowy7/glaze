  "menu": [{ "id": "say-hi", "label": "Say hi" }],
  "commands": [{ "id": "say-hi", "label": "Say hi from Hello", "shortcut": "Ctrl+Alt+Shift+H" }],
  "styles": ["top-bar"],
  "permissions": ["network:https://api.open-meteo.com", "windows", "notifications", "desktop-menu", "shortcuts"]
}
