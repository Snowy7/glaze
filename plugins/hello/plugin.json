{
  "id": "hello",
  "name": "Hello",
  "version": "0.1.0",
  "component": "hello.wasm",
  "api": "0.1",
  "faces": [{ "id": "main", "name": "Demo", "icon": "sparkles", "size": { "default": [8, 5], "min": [6, 4], "max": [12, 8] },
